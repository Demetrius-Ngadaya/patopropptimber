APP_NAME=PatoPro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=https://api.pptimber.co.tz

# URL of the Next.js frontend (used for password reset links and CORS)
FRONTEND_URL=https://pptimber.co.tz
CORS_ALLOWED_ORIGINS=https://pptimber.co.tz,https://www.pptimber.co.tz

# Comma separated IPs of the reverse proxy / Next.js server, or * when behind a trusted load balancer
TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mauzopro
DB_USERNAME=mauzopro
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@pptimber.co.tz
MAIL_FROM_NAME="${APP_NAME}"

# Webline Africa bulk SMS (https://sms.webline.africa)
SMS_ENABLED=false
SMS_API_URL=https://sms.webline.africa/api/v3/sms/send
SMS_API_TOKEN=
SMS_SENDER_ID=TAARIFA

# WhatsApp Business Cloud API (Meta). See config/mauzo.php for the template note.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Online payments by mobile money (Snippe, https://snippe.sh). API key with the
# scopes collection:read + collection:create, and the webhook signing key.
# Switch them on for the till / online shop in Settings -> Online payments.
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
# Only if the API is reached under another address than APP_URL:
SNIPPE_WEBHOOK_URL=

# Database backups (mysqldump must be on the server PATH)
BACKUP_KEEP_DAYS=14
MYSQLDUMP_PATH=mysqldump

# First admin account (username: admin) created by `php artisan migrate --seed`.
# Leave the password empty to get a random one printed once in the terminal.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- AI (optional). Forecasting, anomaly detection, credit scoring and insights
# run inside the system and need nothing here. The assistant, written summaries and
# product descriptions need a language model. Free options (see config/ai.php):
#   AI_PROVIDER=groq        GROQ_API_KEY from https://console.groq.com/keys   (free, ~1,000 requests/day)
#   AI_PROVIDER=gemini      GEMINI_API_KEY from https://aistudio.google.com/apikey (free Flash models)
#   AI_PROVIDER=openrouter  OPENROUTER_API_KEY from https://openrouter.ai/keys  (free models, 50/day)
#   AI_PROVIDER=ollama      no key: runs on your own machine, set OLLAMA_BASE_URL if not local
# Paid: AI_PROVIDER=anthropic with ANTHROPIC_API_KEY, or AI_PROVIDER=openai with AI_BASE_URL + AI_API_KEY.
AI_PROVIDER=groq
GROQ_API_KEY=
# Or give Groq's address and key under these names (the full .../chat/completions URL is fine):
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
ANTHROPIC_API_KEY=
# Optional: override the provider's default models (empty = sensible default).
AI_MODEL=
AI_FAST_MODEL=

# PatoPro mobile app: push notifications through Expo (https://expo.dev)
MOBILE_PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
