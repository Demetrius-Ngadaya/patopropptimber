{
  "expo": {
    "name": "PatoPro",
    "slug": "patopro",
    "scheme": "patopro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F7FB",
    "primaryColor": "#0B3D91",
    "description": "SHEZONI PatoPro: sell, track stock and handle online orders, even without internet.",
    "ios": {
      "bundleIdentifier": "com.shezoni.patopro",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "PatoPro uses the camera to scan product barcodes at the till.",
        "NSFaceIDUsageDescription": "PatoPro uses Face ID to unlock the app.",
        "UIBackgroundModes": [
          "remote-notification",
          "fetch",
          "processing"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shezoni.patopro",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B3D91",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-background-task",
      "expo-localization",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B3D91",
          "defaultChannel": "alert_sound_vibrate",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PatoPro uses the camera to scan product barcodes at the till.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "PatoPro uses Face ID to unlock the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.pptimber.co.tz",
      "eas": {
        "projectId": ""
      }
    }
  }
}
