# Where the Next.js server reaches the Laravel API (server-side only, never sent to browsers)
API_URL=https://api.pptimber.co.tz/api/v1
# (If Next.js and Laravel run on the same server you may use the local address instead.)

# Public URL of this frontend (used for same-origin checks on write requests)
APP_URL=https://pptimber.co.tz

# Set to "false" only for local http:// development
COOKIE_SECURE=true
